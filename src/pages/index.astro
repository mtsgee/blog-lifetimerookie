---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				text-align: center;
				padding: 3rem 1rem;
				margin-bottom: 2rem;
			}

			.hero h1 {
				font-size: 2.5rem;
				margin-bottom: 0.5rem;
				text-wrap: balance;
			}

			.hero-tagline {
				color: rgb(var(--gray));
				font-size: 1.125rem;
				margin-bottom: 1.5rem;
			}

			.hero-intro {
				max-width: 600px;
				margin: 0 auto 2rem auto;
				line-height: 1.7;
			}

			/* Section Cards */
			.section-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.5rem;
				margin-bottom: 3rem;
			}

			.section-card {
				display: flex;
				flex-direction: column;
				padding: 1.5rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 0.5rem;
				text-decoration: none;
				color: inherit;
				transition: border-color 0.2s ease, box-shadow 0.2s ease;
			}

			.section-card:hover {
				border-color: var(--accent);
				box-shadow: 0 2px 8px rgba(0,0,0,0.06);
			}

			.section-card:focus-visible {
				outline: 2px solid var(--accent);
				outline-offset: 2px;
			}

			.section-card h2 {
				font-size: 1.25rem;
				margin: 0 0 0.5rem 0;
				color: var(--accent);
			}

			.section-card p {
				margin: 0;
				font-size: 0.95rem;
				line-height: 1.6;
				color: rgb(var(--gray));
			}

			.social-list {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem 1.5rem;
			}

			.social-list a {
				text-decoration: none;
				transition: color 0.2s ease;
			}

			.social-list a:hover {
				color: var(--accent);
			}

			.social-list a:focus-visible {
				outline: 2px solid var(--accent);
				outline-offset: 2px;
				border-radius: 2px;
			}

			@media (max-width: 640px) {
				.section-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero" aria-labelledby="hero-title">
				<h1 id="hero-title">Lifetime Rookie</h1>
				<p class="hero-tagline">Always learning, never an expert</p>
				<p class="hero-intro">
					Welcome to my corner of the Internet. I write about <strong>personal</strong> growth,
					<strong>money</strong>, and my <strong>interests</strong>.
					Always a student, forever curious.
				</p>
			</section>

			<div class="section-grid">
				<a href="/personal" class="section-card">
					<h2>Personal</h2>
					<p>Portfolio, resume, and professional journey.</p>
				</a>
				<a href="/money" class="section-card">
					<h2>Money</h2>
					<p>Financial analysis, company deep dives, and stock research.</p>
				</a>
				<a href="/interests" class="section-card">
					<h2>Interests</h2>
					<p>Random thoughts, observations, and musings about life.</p>
				</a>
			</div>

			<section aria-labelledby="find-me">
				<h2 id="find-me">Find Me Around the Web</h2>
				<ul class="social-list">
					<li><a href="https://twitter.com/playingcatch">Twitter/X</a></li>
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
