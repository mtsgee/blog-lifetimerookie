---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const moneyPosts = (await getCollection('money')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				text-align: center;
				padding: 4rem 1rem 3rem;
			}

			.hero h1 {
				font-size: 2.75rem;
				margin-bottom: 0.5rem;
				letter-spacing: -0.02em;
			}

			.hero-tagline {
				color: rgb(var(--gray));
				font-size: 1.125rem;
				margin-bottom: 1rem;
			}

			.hero-intro {
				max-width: 600px;
				margin: 0 auto;
				line-height: 1.8;
				color: rgb(var(--gray-dark));
			}

			/* Category sections */
			.section-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.25rem;
				margin-bottom: 3rem;
			}

			.section-card {
				display: flex;
				flex-direction: column;
				padding: 1.5rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: var(--radius);
				text-decoration: none;
				color: inherit;
				transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
				box-shadow: var(--card-shadow);
			}

			.section-card:hover {
				transform: translateY(-2px);
				box-shadow: var(--card-shadow-hover);
				border-color: rgb(var(--gray));
			}

			.section-card h2 {
				font-size: 1.15rem;
				margin: 0 0 0.5rem 0;
			}

			.section-card p {
				margin: 0;
				font-size: 0.9rem;
				line-height: 1.6;
				color: rgb(var(--gray));
			}

			@media (max-width: 640px) {
				.hero { padding: 2.5rem 1rem 2rem; }
				.hero h1 { font-size: 2rem; }
				.section-grid { grid-template-columns: 1fr; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Lifetime Rookie</h1>
				<p class="hero-tagline">Always learning, never an expert</p>
				<p class="hero-intro">
					Welcome. I write about personal growth, money, and whatever else
					catches my curiosity. Always a student, forever open to learning.
				</p>
			</section>

			<div class="section-grid">
				<a href="/personal" class="section-card">
					<span class="card-tag personal">Personal</span>
					<h2>Portfolio &amp; Resume</h2>
					<p>My professional journey, background, and what drives me.</p>
				</a>
				<a href="/money" class="section-card">
					<span class="card-tag money">Money</span>
					<h2>Financial Analysis</h2>
					<p>Company deep dives, stock research, and investing thoughts.</p>
				</a>
				<a href="/interests" class="section-card">
					<span class="card-tag interests">Interests</span>
					<h2>Random Thoughts</h2>
					<p>Observations and musings on life, tech, and everything else.</p>
				</a>
			</div>

			{moneyPosts.length > 0 && (
				<section>
					<h2 class="section-title">Latest Posts</h2>
					<div class="card-grid">
						{moneyPosts.map((post) => (
							<a href={`/money/${post.id}/`} class="card">
								{post.data.heroImage && (
									<img src={post.data.heroImage.src} alt="" class="card-image" />
								)}
								<div class="card-body">
									<span class="card-tag money">Money</span>
									<h3 class="card-title">{post.data.title}</h3>
									{post.data.description && <p class="card-desc">{post.data.description}</p>}
									<span class="card-date"><FormattedDate date={post.data.pubDate} /></span>
								</div>
							</a>
						))}
					</div>
				</section>
			)}
		</main>
		<Footer />
	</body>
</html>
