---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const moneyPosts = (await getCollection('money'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const jams = (await getCollection('music'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 2);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.intro {
				color: rgb(var(--black));
				font-size: 1.25rem;
				font-weight: 600;
				letter-spacing: -0.01em;
				margin: 1.5rem 0 3rem 0;
				line-height: 1.5;
			}

			.jam-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}

			.jam-list .track {
				display: flex;
				gap: 1.25rem;
				align-items: flex-start;
				padding: 1.1rem 0;
			}

			.jam-list .track:first-child {
				padding-top: 0;
			}

			/* Click-to-load YouTube embed (same as /music) */
			.embed {
				position: relative;
				flex: none;
				width: 160px;
				aspect-ratio: 16 / 9;
				border-radius: var(--radius);
				overflow: hidden;
				background: rgb(var(--gray-bg));
			}

			.embed img {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0;
			}

			.embed button {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				display: flex;
				align-items: center;
				justify-content: center;
				border: none;
				padding: 0;
				margin: 0;
				background: rgba(0, 0, 0, 0.25);
				cursor: pointer;
				font-size: 0;
				transition: background 0.15s ease;
			}

			.embed button::after {
				content: '';
				width: 0;
				height: 0;
				border-left: 14px solid #fff;
				border-top: 9px solid transparent;
				border-bottom: 9px solid transparent;
				margin-left: 4px;
			}

			.embed button:hover {
				background: rgba(0, 0, 0, 0.45);
			}

			.embed iframe {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				border: 0;
			}

			.track-meta {
				flex: 1;
				min-width: 0;
			}

			.track-title {
				margin: 0;
				font-size: 1.05rem;
				font-weight: 650;
				line-height: 1.4;
			}

			.track-title a {
				color: rgb(var(--black));
			}

			.track-title a:hover {
				color: var(--accent);
			}

			.track-artist {
				margin: 0.15rem 0 0;
				color: rgb(var(--gray-dark));
				font-size: 0.95rem;
			}

			.track-note {
				margin: 0.4rem 0 0;
				color: rgb(var(--gray));
				font-size: 0.92rem;
				line-height: 1.55;
			}

			@media (max-width: 560px) {
				.jam-list .track {
					flex-direction: column;
					gap: 0.9rem;
				}

				.embed {
					width: 100%;
				}
			}

			section + section {
				margin-top: 3rem;
			}

			.more-links {
				margin-top: 2.5rem;
				font-size: 0.9rem;
				color: rgb(var(--gray));
			}

			.more-links a {
				color: rgb(var(--gray-dark));
				font-weight: 500;
			}

			.more-links a:hover {
				color: var(--accent);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<p class="intro">Always learning, never an expert.</p>

			{jams.length > 0 && (
				<section>
					<h2 class="section-title">Jams First</h2>
					<ul class="jam-list">
						{jams.map((t) => (
							<li class="track">
								<div class="embed" data-video={t.data.videoId}>
									<img src={`https://i.ytimg.com/vi/${t.data.videoId}/hqdefault.jpg`} alt="" loading="lazy" />
									<button type="button" aria-label={`Play ${t.data.title}`}></button>
								</div>
								<div class="track-meta">
									<h3 class="track-title"><a href={t.data.url} target="_blank" rel="noopener">{t.data.title}</a></h3>
									<p class="track-artist">{t.data.artist}</p>
									{t.data.note && <p class="track-note">{t.data.note}</p>}
								</div>
							</li>
						))}
					</ul>
					<a class="view-all" href="/music">All jams →</a>
				</section>
			)}

			{moneyPosts.length > 0 && (
				<section>
					<h2 class="section-title">Latest Writing</h2>
					<ul class="post-list">
						{moneyPosts.map((post) => (
							<li>
								<a href={`/money/${post.id}/`}>
									<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
									<span class="post-title">{post.data.title}</span>
									{post.data.description && <p class="post-desc">{post.data.description}</p>}
								</a>
							</li>
						))}
					</ul>
					<a class="view-all" href="/money">All money posts →</a>
				</section>
			)}

			<p class="more-links">
				<a href="/personal">Personal</a> &nbsp;·&nbsp; <a href="/music">Music</a> &nbsp;·&nbsp; <a href="/reverse-dcf">Reverse DCF calculator</a>
			</p>
		</main>
		<Footer />

		<script>
			// Swap the thumbnail for a YouTube player on click — nothing loads until then.
			document.querySelectorAll('.embed').forEach((el) => {
				const btn = el.querySelector('button');
				btn?.addEventListener('click', () => {
					const id = el.getAttribute('data-video');
					el.innerHTML =
						'<iframe src="https://www.youtube-nocookie.com/embed/' + id +
						'?autoplay=1&rel=0" title="YouTube video player" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>';
				});
			});
		</script>
	</body>
</html>
