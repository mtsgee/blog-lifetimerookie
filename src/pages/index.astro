---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const moneyPosts = (await getCollection('money')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.intro {
				color: rgb(var(--black));
				font-size: 1.25rem;
				font-weight: 600;
				letter-spacing: -0.01em;
				margin: 1.5rem 0 3rem 0;
				line-height: 1.5;
			}

			.more-links {
				margin-top: 2.5rem;
				font-size: 0.9rem;
				color: rgb(var(--gray));
			}

			.more-links a {
				color: rgb(var(--gray-dark));
				font-weight: 500;
			}

			.more-links a:hover {
				color: var(--accent);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<p class="intro">Always learning, never an expert.</p>

			{moneyPosts.length > 0 && (
				<section>
					<h2 class="section-title">Latest Writing</h2>
					<ul class="post-list">
						{moneyPosts.map((post) => (
							<li>
								<a href={`/money/${post.id}/`}>
									<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
									<span class="post-title">{post.data.title}</span>
									{post.data.description && <p class="post-desc">{post.data.description}</p>}
								</a>
							</li>
						))}
					</ul>
					<a class="view-all" href="/money">All money posts →</a>
				</section>
			)}

			<p class="more-links">
				<a href="/personal">Personal</a> &nbsp;·&nbsp; <a href="/reverse-dcf">Reverse DCF calculator</a>
			</p>
		</main>
		<Footer />
	</body>
</html>
