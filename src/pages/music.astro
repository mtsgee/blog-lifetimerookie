---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const tracks = (await getCollection('music')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Music | ${SITE_TITLE}`} description="What I'm listening to — songs and albums worth sharing." />
		<style>
			.listening {
				list-style: none;
				padding: 0;
				margin: 0;
			}

			.track {
				border-top: 1px solid rgb(var(--gray-mid));
				padding: 1.5rem 0;
				display: flex;
				gap: 1.25rem;
				align-items: flex-start;
			}

			.track:last-child {
				border-bottom: 1px solid rgb(var(--gray-mid));
			}

			/* Click-to-load YouTube embed */
			.embed {
				position: relative;
				flex: none;
				width: 160px;
				aspect-ratio: 16 / 9;
				border-radius: var(--radius);
				overflow: hidden;
				background: rgb(var(--gray-bg));
			}

			.embed img {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0;
			}

			.embed button {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				display: flex;
				align-items: center;
				justify-content: center;
				border: none;
				padding: 0;
				margin: 0;
				background: rgba(0, 0, 0, 0.25);
				cursor: pointer;
				color: #fff;
				font-size: 0;
				transition: background 0.15s ease;
			}

			.embed button::after {
				content: '';
				width: 0;
				height: 0;
				border-left: 14px solid #fff;
				border-top: 9px solid transparent;
				border-bottom: 9px solid transparent;
				margin-left: 4px;
			}

			.embed button:hover {
				background: rgba(0, 0, 0, 0.45);
			}

			.embed iframe {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				border: 0;
			}

			.track-meta {
				flex: 1;
				min-width: 0;
			}

			.track-kicker {
				margin: 0;
				font-size: 0.75rem;
				font-weight: 600;
				letter-spacing: 0.05em;
				text-transform: uppercase;
				color: rgb(var(--gray));
			}

			.track-title {
				margin: 0.3rem 0 0;
				font-size: 1.1rem;
				font-weight: 650;
				line-height: 1.4;
			}

			.track-title a {
				color: rgb(var(--black));
			}

			.track-title a:hover {
				color: var(--accent);
			}

			.track-artist {
				margin: 0.15rem 0 0;
				color: rgb(var(--gray-dark));
				font-size: 0.95rem;
			}

			.track-note {
				margin: 0.5rem 0 0;
				color: rgb(var(--gray));
				font-size: 0.92rem;
				line-height: 1.55;
			}

			@media (max-width: 560px) {
				.track {
					flex-direction: column;
					gap: 0.9rem;
				}

				.embed {
					width: 100%;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<h1>Music</h1>
				<p>What I'm listening to — songs and albums worth sharing.</p>
			</div>

			{tracks.length > 0 ? (
				<ul class="listening">
					{tracks.map((t) => (
						<li class="track">
							<div class="embed" data-video={t.data.videoId}>
								<img src={`https://i.ytimg.com/vi/${t.data.videoId}/hqdefault.jpg`} alt="" loading="lazy" />
								<button type="button" aria-label={`Play ${t.data.title}`}></button>
							</div>
							<div class="track-meta">
								<p class="track-kicker">{t.data.type} &middot; <FormattedDate date={t.data.pubDate} /></p>
								<h2 class="track-title"><a href={t.data.url}>{t.data.title}</a></h2>
								<p class="track-artist">{t.data.artist}</p>
								{t.data.note && <p class="track-note">{t.data.note}</p>}
							</div>
						</li>
					))}
				</ul>
			) : (
				<div class="empty-state">
					<p>Nothing here yet. Check back soon!</p>
				</div>
			)}
		</main>
		<Footer />

		<script>
			// Swap the thumbnail for a YouTube player on click — nothing loads until then.
			document.querySelectorAll('.embed').forEach((el) => {
				const btn = el.querySelector('button');
				btn?.addEventListener('click', () => {
					const id = el.getAttribute('data-video');
					el.innerHTML =
						'<iframe src="https://www.youtube-nocookie.com/embed/' + id +
						'?autoplay=1&rel=0" title="YouTube video player" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>';
				});
			});
		</script>
	</body>
</html>
