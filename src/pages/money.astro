---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const posts = (await getCollection('money')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Money | ${SITE_TITLE}`} description="Financial analysis, company deep dives, and stock research." />
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<h1>Money</h1>
				<p>Financial analysis, company deep dives, and stock research</p>
			</div>
			{posts.length > 0 ? (
				<ul class="post-list">
					{posts.map((post) => (
						<li>
							<a href={`/money/${post.id}/`}>
								<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
								<span class="post-title">{post.data.title}</span>
								{post.data.description && <p class="post-desc">{post.data.description}</p>}
							</a>
						</li>
					))}
				</ul>
			) : (
				<div class="empty-state">
					<p>No posts yet. Check back soon!</p>
				</div>
			)}
		</main>
		<Footer />
	</body>
</html>
