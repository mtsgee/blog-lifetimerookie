---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<p class="tagline">Always learning, never an expert</p>
		<p class="copyright">
			&copy; {today.getFullYear()} Lifetime Rookie. Built with
			<a href="https://astro.build">Astro</a>, deployed on
			<a href="https://cloudflare.com">Cloudflare</a>.
		</p>
		<p class="social">
			<a href="https://twitter.com/playingcatch" target="_blank" rel="noopener noreferrer">Twitter/X</a>
			<span class="sep">&middot;</span>
			<a href="/rss.xml">RSS</a>
		</p>
	</div>
</footer>
<style>
	footer {
		border-top: 1px solid rgb(var(--gray-light));
		background: rgb(var(--gray-bg));
		text-align: center;
		font-size: 0.85rem;
		color: rgb(var(--gray));
	}

	.footer-inner {
		max-width: 900px;
		margin: 0 auto;
		padding: 2.5rem 1.5rem 3rem;
	}

	.tagline {
		font-style: italic;
		margin: 0 0 0.75rem 0;
	}

	.copyright {
		margin: 0 0 0.75rem 0;
	}

	.copyright a {
		color: rgb(var(--gray-dark));
	}

	.copyright a:hover {
		color: var(--accent);
	}

	.social {
		margin: 0;
	}

	.social a {
		color: rgb(var(--gray-dark));
		font-weight: 500;
	}

	.social a:hover {
		color: var(--accent);
	}

	.sep {
		margin: 0 0.5rem;
		color: rgb(var(--gray-light));
	}
</style>
