---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<p>
			&copy; {today.getFullYear()} Lifetime Rookie
			&middot; <a href="/rss.xml">RSS</a>
			&middot; Built with <a href="https://astro.build">Astro</a> on <a href="https://cloudflare.com">Cloudflare</a>
		</p>
	</div>
</footer>
<style>
	footer {
		border-top: 1px solid rgb(var(--gray-light));
		text-align: center;
		font-size: 0.85rem;
		color: rgb(var(--gray));
	}

	.footer-inner {
		max-width: 720px;
		margin: 0 auto;
		padding: 1.75rem 1.5rem 2rem;
	}

	footer p {
		margin: 0;
	}

	footer a {
		color: rgb(var(--gray-dark));
	}

	footer a:hover {
		color: var(--accent);
	}
</style>
